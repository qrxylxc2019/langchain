# ==========================================
# AI 模型提供商配置
# ==========================================

# ---------- LLM 提供商配置 ----------
# 支持: deepseek / dashscope(百炼)
# deepseek: 使用 DeepSeek API 进行对话
# dashscope: 使用阿里云百炼 API 进行对话
PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_API_KEY=sk-efdf1bc22e104510a3b849e19e910f6c
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼配置（备用对话提供商）
DASHSCOPE_API_KEY=sk-2ff14e2b4c3d4f95a2fd506eabf56186
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-pro

# ---------- Embedding 提供商配置 ----------
# 支持: siliconflow(硅基流动) / dashscope(百炼)
# 硅基流动推荐模型: BAAI/bge-large-zh-v1.5, BAAI/bge-m3
# 百炼推荐模型: text-embedding-v3, text-embedding-v4
EMBEDDING_PROVIDER=siliconflow

# 硅基流动 Embedding 配置
SILICONFLOW_API_KEY=sk-zhapdjufqobymwzfudcgmblbqdmxkuubxwluoskalkuhrkzj
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 阿里云百炼 Embedding 配置（备用）
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ==========================================
# Flask 服务配置
# ==========================================
FLASK_PORT=5000
FLASK_DEBUG=True
